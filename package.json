{
  "name": "nuxt-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:postgres:generate": "drizzle-kit generate --config layers/db-postgres/drizzle.config.ts",
    "db:postgres:migrate": "drizzle-kit migrate --config layers/db-postgres/drizzle.config.ts",
    "db:postgres:studio": "drizzle-kit studio --config layers/db-postgres/drizzle.config.ts",
    "db:sqlite:generate": "drizzle-kit generate --config layers/db-sqlite/drizzle.config.ts",
    "db:sqlite:migrate": "drizzle-kit migrate --config layers/db-sqlite/drizzle.config.ts",
    "db:sqlite:studio": "drizzle-kit studio --config layers/db-sqlite/drizzle.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
}
