# Copy to .env and fill in. Each var maps to a key in `runtimeConfig` (nuxt.config.ts).

# Public (exposed to the browser): runtimeConfig.public.siteUrl
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: runtimeConfig.exampleSecret
NUXT_EXAMPLE_SECRET=

# --- layers/db-postgres (remove with the layer) ---
# Empty = embedded PGlite in .data/pglite. Example: postgres://user:pass@localhost:5432/app
NUXT_POSTGRES_URL=
# NUXT_POSTGRES_AUTO_MIGRATE=true

# --- layers/db-sqlite (remove with the layer) ---
# NUXT_SQLITE_PATH=.data/sqlite.db
# NUXT_SQLITE_AUTO_MIGRATE=true
